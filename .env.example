# ================================================================
# DATABASE (optional)
# ================================================================
# Point this at a directly reachable DB, or at the LOCAL endpoint
# of an SSH tunnel (see SSH_TUNNEL_* below).
#
# Uncomment + set DATABASE_URL to enable the DB fixture:
#
# DATABASE_URL=postgresql://user:password@localhost:15432/mydb


# ================================================================
# SSH TUNNEL (optional)
# ================================================================
# When SSH_TUNNEL_ENABLED=true, the framework opens an SSH
# connection and forwards localhost:<SSH_TUNNEL_LOCAL_PORT> to
# <SSH_TUNNEL_REMOTE_HOST>:<SSH_TUNNEL_REMOTE_PORT>. Prisma then
# connects to the local forwarded port.
#
# Set SSH_TUNNEL_PRIVATE_KEY_PATH (preferred) OR SSH_TUNNEL_PASSWORD.
#
# Default: disabled.
#
# SSH_TUNNEL_ENABLED=false
# SSH_TUNNEL_HOST=
# SSH_TUNNEL_PORT=22
# SSH_TUNNEL_USERNAME=
# SSH_TUNNEL_PRIVATE_KEY_PATH=
# SSH_TUNNEL_PASSWORD=
# SSH_TUNNEL_LOCAL_PORT=15432
# SSH_TUNNEL_REMOTE_HOST=
# SSH_TUNNEL_REMOTE_PORT=5432
